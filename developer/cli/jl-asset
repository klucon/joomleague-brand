#!/usr/bin/env python3
import argparse, json
from pathlib import Path

RULES = {
    "browser-favicon": "favicons/favicon.svg",
    "browser-fallback": "favicons/favicon.ico",
    "apple": "favicons/apple-touch-icon.png",
    "android": "favicons/android-chrome-192x192.png",
    "android-maskable": "favicons/android-chrome-maskable-512x512.png",
    "joomla-menu": "developer/svg/joomleague-symbol-currentcolor.svg",
    "joomla-toolbar": "developer/svg/joomleague-symbol-outline.svg",
    "dark": "developer/svg/joomleague-symbol-white.svg",
    "light": "developer/svg/joomleague-symbol-blue.svg",
    "social": "social/joomleague-social-1200x630.png",
    "github": "banners/joomleague-github-1280x640.png",
    "website": "banners/joomleague-banner-1920x600.png",
    "print-logo": "print/cmyk/joomleague-logo-CMYK-300dpi.tif",
}

def main():
    p=argparse.ArgumentParser(description="Select a JoomLeague asset for a context.")
    p.add_argument("context", choices=sorted(RULES))
    p.add_argument("--root", default=".", help="Brand pack root")
    p.add_argument("--json", action="store_true")
    args=p.parse_args()
    rel=RULES[args.context]
    path=Path(args.root)/rel
    if args.json:
        print(json.dumps({"context":args.context,"asset":rel,"exists":path.exists()}, indent=2))
    else:
        print(rel)
    return 0 if path.exists() else 1

if __name__ == "__main__":
    raise SystemExit(main())
